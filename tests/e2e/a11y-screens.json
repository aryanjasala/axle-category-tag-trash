    {
      "name": "Tools > Category & Tag Trash, merge screen with nothing to merge",
      "url": "/wp-admin/tools.php?page=axle-category-tag-trash&view=merge&taxonomy=post_tag&terms=999999"
    },
    {
      "name": "Tools > Category & Tag Trash after a merge, with Undo and the merged term in the list",
      "setup": [
        {
          "wp": [
            "term",
            "create",
            "post_tag",
            "A11y source",
            "--porcelain"
          ],
          "save": "src"
        },
        {
