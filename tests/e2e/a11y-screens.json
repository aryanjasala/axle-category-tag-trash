            "term",
            "create",
            "post_tag",
            "A11y target",
            "--porcelain"
          ],
          "save": "tgt"
        },
        [
          "axle-category-tag-trash",
          "merge",
          "{src}",
          "{tgt}",
          "--taxonomy=post_tag"
        ],
        {
          "wp": [
            "axle-category-tag-trash",
            "list",
            "--taxonomy=post_tag",
            "--format=ids"
          ],
          "save": "item"
        }
      ],
      "url": "/wp-admin/tools.php?page=axle-category-tag-trash&actt_merged={item}",
      "cleanup": [
        [
          "term",
          "delete",
          "post_tag",
          "{tgt}"
        ],
        [
          "axle-category-tag-trash",
          "delete",
          "--all",
          "--yes"
        ]
      ]
    },
    {
      "name": "Tools > Category & Tag Trash with a merge running in the background",
      "setup": [
        {
          "wp": [
            "term",
            "create",
            "post_tag",
            "A11y source",
            "--porcelain"
          ],
          "save": "src"
        },
        {
          "wp": [
            "term",
            "create",
            "post_tag",
            "A11y target",
            "--porcelain"
          ],
          "save": "tgt"
        },
        [
          "eval",
          "$job = wp_insert_post( array( 'post_type' => 'axle_ctt_item', 'post_status' => 'draft', 'post_title' => 'A11y running source' ) ); update_post_meta( $job, '_axle_category_tag_trash_merge_job', array( 'source_id' => (int) '{src}', 'source_tt_id' => 0, 'source_name' => 'A11y running source', 'target_id' => (int) '{tgt}', 'target_tt_id' => 0, 'target_name' => 'A11y running target', 'taxonomy' => 'post_tag', 'children' => 'target', 'total' => 500, 'moved' => 200 ) );"
        ]
      ],
      "url": "/wp-admin/tools.php?page=axle-category-tag-trash",
      "cleanup": [
        [
          "eval",
          "foreach ( get_posts( array( 'post_type' => 'axle_ctt_item', 'post_status' => 'draft', 'numberposts' => -1, 'fields' => 'ids' ) ) as $id ) { wp_delete_post( $id, true ); }"
        ],
        [
          "term",
          "delete",
          "post_tag",
          "{src}",
          "{tgt}"
        ],
        [
          "axle-category-tag-trash",
          "delete",
          "--all",
          "--yes"
        ]
      ]
    },
